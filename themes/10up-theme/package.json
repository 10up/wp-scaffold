{
  "name": "tenup-theme",
  "version": "1.0.0",
  "scripts": {
    "start": "npm run watch",
    "watch": "vp build --watch",
    "build": "vp build && vp build --mode modules",
    "check": "vp check && tsgo --noEmit",
    "typecheck": "tsgo --noEmit",
    "format-js": "vp fmt --write",
    "lint-js": "vp lint",
    "lint-style": "stylelint \"assets/css/**/*.css\"",
    "test": "vp test run --passWithNoTests",
    "clean-dist": "rm -rf ./dist",
    "scaffold:block": "cd blocks/ && wp-create-block --no-plugin --template ../../../../bin/create-block-template"
  },
  "dependencies": {
    "@wordpress/block-editor": "^15.6.0",
    "@wordpress/blocks": "^15.2.0",
    "@wordpress/dom-ready": "^4.47.0",
    "@wordpress/i18n": "^6.13.0",
    "modern-normalize": "^3.0.0"
  },
  "devDependencies": {
    "@10up/wp-vite-plugins": "file:../../packages/10up-wp-vite-plugins-0.1.0-beta.0.tgz",
    "@types/react": "^18.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260610.1",
    "vite-plus": "^0.1.24"
  }
}
