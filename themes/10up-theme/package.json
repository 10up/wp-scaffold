{
  "name": "tenup-theme",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm run watch",
    "build": "vp build",
    "watch": "vp build --watch",
    "dev": "vp dev",
    "check": "vp check && tsgo --noEmit",
    "typecheck": "tsgo --noEmit",
    "format-js": "vp fmt",
    "lint-js": "vp lint",
    "test": "vp test run --passWithNoTests",
    "clean-dist": "rm -rf ./dist",
    "scaffold:block": "cd blocks/ && wp-create-block --no-plugin --template ../../../../bin/create-block-template"
  },
  "dependencies": {
    "@wordpress/block-editor": "^15.6.0",
    "@wordpress/blocks": "^15.2.0",
    "@wordpress/dom-ready": "^4.47.0",
    "@wordpress/i18n": "^6.13.0",
    "@wordpress/interactivity": "^6.33.3",
    "modern-normalize": "^3.0.0"
  },
  "devDependencies": {
    "@10up/wp-vite-plugins": "^1.0.0-alpha.4",
    "@types/react": "^18.3.0",
    "@types/wordpress__block-editor": "^15.0.9",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "vite-plus": "^1.6.0"
  }
}
