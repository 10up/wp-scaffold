{
  "name": "tenup-block-theme",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm run watch",
    "build": "wp-vite build --bin vp",
    "watch": "wp-vite watch --bin vp",
    "dev": "wp-vite dev --bin vp",
    "check": "vp check && tsgo --noEmit",
    "typecheck": "tsgo --noEmit",
    "format-js": "vp fmt",
    "lint-js": "vp lint",
    "lint-style": "stylelint \"assets/css/**/*.css\"",
    "test": "vp test run --passWithNoTests",
    "clean-dist": "rm -rf ./dist",
    "wp-compat": "wp-gutenberg-compat analyze",
    "wp-compat:fix": "wp-gutenberg-compat install",
    "wp-compat:info": "wp-gutenberg-compat info",
    "scaffold:block": "cd blocks/ && wp-create-block --no-plugin --template ../../../../bin/create-block-template"
  },
  "dependencies": {
    "@10up/block-components": "^1.22.1",
    "@wordpress/block-editor": "^15.6.0",
    "@wordpress/blocks": "^15.2.0",
    "@wordpress/dom-ready": "^4.47.0",
    "@wordpress/i18n": "^6.13.0",
    "@wordpress/interactivity": "^6.33.3"
  },
  "devDependencies": {
    "@10up/wp-vite-plugins": "^1.0.0-alpha.3",
    "@ravi.nder/wp-gutenberg-compat": "^0.5.1",
    "@types/react": "^18.3.0",
    "@types/wordpress__block-editor": "^15.0.9",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "vite-plus": "^1.5.0"
  }
}
