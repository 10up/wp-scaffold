import { __ } from '@wordpress/i18n';
{{#isInnerBlocksVariant}}
import { useBlockProps, useInnerBlocksProps } from '@wordpress/block-editor';

/**
 * Blocks inserted when the block is added. Restrict what editors may add
 * with `allowedBlocks` in block.json.
 */
const TEMPLATE = [['core/paragraph', { placeholder: __('Add content…', '{{textdomain}}') }]];

/**
 * Editor component for the {{title}} block.
 *
 * @returns The block wrapper with its inner blocks.
 */
export const BlockEdit = () => {
	const innerBlocksProps = useInnerBlocksProps(useBlockProps(), {
		template: TEMPLATE,
		// Deliberately unlocked: editors may add, move and remove inner blocks.
		templateLock: false,
	});

	return <div {...innerBlocksProps} />;
};
{{/isInnerBlocksVariant}}
{{^isInnerBlocksVariant}}
import { RichText, useBlockProps } from '@wordpress/block-editor';
import type { BlockEditProps } from '@wordpress/blocks';

type Attributes = {
	content: string;
};

/**
 * Editor component for the {{title}} block. Content is edited inline, in
 * markup that mirrors render.php.
 *
 * @param props Block edit props.
 * @returns The block as it renders in the editor.
 */
export const BlockEdit = (props: BlockEditProps<Attributes>) => {
	const { attributes, setAttributes } = props;
	const blockProps = useBlockProps();

	return (
		<div {...blockProps}>
			<RichText
				tagName="p"
				className="wp-block-{{namespace}}-{{slug}}__content"
				placeholder={__('Add text…', '{{textdomain}}')}
				value={attributes.content}
				onChange={(content) => setAttributes({ content })}
			/>
		</div>
	);
};
{{/isInnerBlocksVariant}}
