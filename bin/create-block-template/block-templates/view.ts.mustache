{{#isInteractiveVariant}}
import { store, getContext } from '@wordpress/interactivity';

/**
 * Per-instance state, set in render.php through `data-wp-context`.
 */
type Context = {
	isOpen: boolean;
};

type Store = {
	state: Record<string, never>;
	actions: {
		toggle: () => void;
	};
	callbacks: Record<string, never>;
};

/**
 * Frontend behavior for the {{title}} block. The store namespace is the block
 * name, matching `data-wp-interactive` in render.php.
 */
store<Store>('{{namespace}}/{{slug}}', {
	state: {},
	actions: {
		toggle() {
			const context = getContext<Context>();
			context.isOpen = !context.isOpen;
		},
	},
	callbacks: {},
});
{{/isInteractiveVariant}}
